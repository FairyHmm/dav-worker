{
  "name": "dav-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy -c src/app/worker/wrangler.jsonc",
    "dev": "wrangler dev -c src/app/worker/wrangler.jsonc",
    "format": "oxfmt --write .",
    "lint:fix": "oxlint --fix",
    "start": "wrangler dev -c src/app/worker/wrangler.jsonc",
    "cf-typegen": "wrangler types -c src/app/worker/wrangler.jsonc src/app/worker/worker-configuration.d.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "6.0.3",
    "wrangler": "^4.110.0"
  }
}
