{
  "name": "dav-worker",
  "version": "0.1.0",
  "private": true,
  "author": "Fairy",
  "license": "AGPL-3.0-only",
  "description": "Cloudflare Worker exposing an MCP server backed by Nextcloud — files, calendar, and tasks",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:ui": "pnpm --filter \"./src/packages/ui/*\" build",
    "deploy:worker": "pnpm -F @dav-worker/app-worker run deploy",
    "dry-run:worker": "pnpm -F @dav-worker/app-worker dry-run",
    "format": "oxfmt --write .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "source-map-explorer": "^2.5.3",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "vitest": "^3.2.1",
    "wrangler": "^4.119.0"
  }
}
