# Copy to .dev.vars (gitignored) and fill in. Read via process.env — this
# app has no Cloudflare bindings, it's a plain Node/stdio process.

NEXTCLOUD_HOST=https://cloud.example.com
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=

# Optional. If unset, falls back to the bundled fixtures/config.toml —
# handy before you've put a real config file on your Nextcloud yet.
# CONFIG_PATH=/config.toml
