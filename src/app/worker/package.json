{
  "name": "@dav-worker/app-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "build": "tsx build.mts",
    "dev": "wrangler dev -c wrangler.jsonc",
    "deploy": "pnpm run build && wrangler deploy -c wrangler.jsonc",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run --outdir dist -c wrangler.jsonc",
    "analyze": "source-map-explorer dist/**/*.js --no-border-checks",
    "cf-typegen": "wrangler types -c wrangler.jsonc worker-configuration.d.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@dav-worker/calendar-ical": "workspace:*",
    "@dav-worker/calendar-tools": "workspace:*",
    "@dav-worker/config-parser": "workspace:*",
    "@dav-worker/files-locations": "workspace:*",
    "@dav-worker/files-tools": "workspace:*",
    "@dav-worker/storage-nextcloud": "workspace:*",
    "@dav-worker/task-tools": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@dav-worker/worker-trim": "workspace:*",
    "esbuild": "^0.28.1",
    "source-map-explorer": "^2.5.3",
    "tsx": "^4.23.9",
    "wrangler": "^4.119.0"
  }
}
