{
  "name": "@dav-worker/app-worker",
  "version": "0.1.3",
  "private": true,
  "author": "Fairy",
  "license": "AGPL-3.0-only",
  "description": "Cloudflare Worker: OAuth + consent screen + MCP endpoint",
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "build": "pnpm -w run build:ui && pnpm run build:consent && tsx build.mts",
    "build:consent": "vite build --config consent/vite.config.ts",
    "dev": "wrangler dev -c wrangler.jsonc",
    "dev:consent": "vite dev --config consent/vite.config.ts",
    "deploy": "pnpm run build && wrangler deploy -c wrangler.jsonc",
    "dry-run": "pnpm run build && wrangler deploy --dry-run --outdir dist -c wrangler.jsonc",
    "analyze": "source-map-explorer dist/**/*.js --no-border-checks",
    "typegen": "wrangler types -c wrangler.jsonc worker-configuration.d.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@lucide/svelte": "^1.29.0",
    "@dav-worker/mcp-utils": "workspace:*",
    "@dav-worker/server-core": "workspace:*",
    "@dav-worker/storage-nextcloud": "workspace:*",
    "@dav-worker/ui-shared": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@dav-worker/worker-trim": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "esbuild": "^0.28.1",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "^4.119.0"
  }
}
