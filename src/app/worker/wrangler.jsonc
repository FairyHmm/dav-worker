{
  // No OAUTH_KV: auth is fully stateless. See Docs/archive/SPEC-STATELESS-AUTH.md.
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "dav-worker",
  "main": "dist/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "Text", "globs": ["**/*.toml", "**/*.csv"], "fallthrough": true },
  ],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
